# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default). Switch to PostgreSQL by changing this one line.
DATABASE_URL=sqlite:///./data/whatsapp_outreach.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/whatsapp_outreach

# ── Localisation ──────────────────────────────────────────────────────────
APP_TIMEZONE=Africa/Cairo

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Safety Controls ───────────────────────────────────────────────────────
GLOBAL_DAILY_LIMIT=100

# ── Web Control Center (Phase 7 / Cloud Production) ───────────────────────
# Local development defaults (Production Vercel overrides these in deployment dashboard)
APP_ENV=development
DEBUG=False
ALLOWED_HOSTS=*
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_KEY
COOKIE_SECURE=False
LOG_TO_FILE=True
RUNNER_REMOTE_COORDINATION=False
