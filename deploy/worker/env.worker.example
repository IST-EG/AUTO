# ==============================================================================
# Worker VPS Environment Configuration Template
# Place in: /opt/whatsapp-outreach/.env
# ==============================================================================

# Supabase PostgreSQL Direct / Session Connection (Port 5432)
# IMPORTANT: Copy the exact URI from Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct
# Do NOT assume any region or host; paste the exact hostname provided by your Supabase project.
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-DIRECT-HOST]:5432/postgres?sslmode=require

# Application Environment
APP_ENV=production
ENVIRONMENT=production
APP_TIMEZONE=Africa/Cairo
GLOBAL_DAILY_LIMIT=100
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_FILE=/opt/whatsapp-outreach/logs/app.log
LOG_JSON_FILE=/opt/whatsapp-outreach/logs/app.json.log

# X11 Virtual Framebuffer Display
DISPLAY=:99

# WhatsApp Web Automation Settings
WHATSAPP_SESSION_PATH=/opt/whatsapp-outreach/data/whatsapp_session
# WHATSAPP_HEADLESS must be False: Chrome for Testing runs on Xvfb :99 (WhatsApp blocks headless mode)
WHATSAPP_HEADLESS=False
WHATSAPP_BROWSER_TIMEOUT=30
WHATSAPP_PAGE_LOAD_TIMEOUT=45
WHATSAPP_QR_TIMEOUT=120

# Browser and Driver Binaries:
# - Oracle Cloud Always Free ARM64 (Google Chrome for Testing Stable):
WHATSAPP_CHROME_BINARY=/opt/google/chrome-for-testing/chrome
WHATSAPP_CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# Production Runner Settings
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_HEARTBEAT_SECONDS=15
RUNNER_LOCK_FILE=/opt/whatsapp-outreach/data/runner.lock
RUNNER_REMOTE_COORDINATION=False
CLI_PAGE_SIZE=20

# Worker Identity (Phase 7.7-B Step 7)
# A stable, human-readable label uniquely identifying this worker instance.
# Used by the dashboard to distinguish workers and track infrastructure health heartbeats.
#
# Format rules:
#   - Characters: [a-z0-9-] only (lowercase letters, digits, hyphens)
#   - Length: 3 to 64 characters
#   - Must not start or end with a hyphen
#   - Must be unique per worker host
#   - MUST NOT be an IP address or hostname (use a logical name)
#   - Is not a secret; it is safe to display in the dashboard
#
# Example:
#   WORKER_INSTANCE_ID=oracle-arm64-worker-01
#
WORKER_INSTANCE_ID=oracle-arm64-worker-01
