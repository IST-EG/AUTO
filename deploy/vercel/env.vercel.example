# ==============================================================================
# Vercel Production Environment Variables Template
# Configure in: Vercel Project Settings -> Environment Variables
# ==============================================================================

# Application Environment & Runtime
APP_ENV=production
DEBUG=False
VERCEL=1

# Supabase PostgreSQL Transaction Pooler Connection (Port 6543 / PgBouncer Transaction Mode)
# IMPORTANT: Copy the exact URI from Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
# Do NOT assume any region or host; paste the exact hostname provided by your Supabase project.
DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-SUPABASE-POOLER-HOST]:6543/postgres?sslmode=require

# Web Security & Host Protection
SECRET_KEY=[GENERATE-64-CHAR-HEX-KEY-VIA-SECRETS-TOKEN-HEX-32]
ALLOWED_HOSTS=auto.integra-ist.com,*.vercel.app
COOKIE_SECURE=True
WEB_SESSION_COOKIE_NAME=outreach_session_id
WEB_CSRF_COOKIE_NAME=outreach_csrf_token
WEB_COOKIE_SAMESITE=lax
WEB_SESSION_INACTIVITY_MINUTES=30
WEB_SESSION_ABSOLUTE_HOURS=12
WEB_MAX_CONCURRENT_SESSIONS=2
WEB_MAX_FAILED_LOGINS=5
WEB_LOCKOUT_MINUTES=15

# Timezone & Operational Safety
APP_TIMEZONE=Africa/Cairo
GLOBAL_DAILY_LIMIT=100
LOG_LEVEL=INFO
LOG_TO_FILE=False

# Remote Runner Coordination (Control Plane Mode)
RUNNER_REMOTE_COORDINATION=True
